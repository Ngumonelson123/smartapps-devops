# terraform/backend.hcl.example
# Copy to backend.hcl and fill in values from bootstrap output.
# NEVER commit backend.hcl — it contains your AWS account ID.
#
# Usage:
#   terraform init \
#     -backend-config="backend.hcl" \
#     -backend-config="key=qa/terraform.tfstate"

bucket         = "smartapps-terraform-state-<ACCOUNT_ID>"
region         = "<AWS_REGION>"
dynamodb_table = "smartapps-tf-locks"
encrypt        = true
